# /opt/stacks/mathium/.env  (chmod 600). Never commit real values.

# Binding (tailnet-only until the site is approved to go public)
BIND_ADDRESS=100.88.107.120
WEB_PORT=3100
MATHIUM_TAG=latest

# Database and data API
POSTGRES_PASSWORD=
AUTHENTICATOR_PASSWORD=
PGRST_JWT_SECRET=            # >= 32 chars; shared by PostgREST and the app

# App
NEXT_PUBLIC_APP_URL=https://mathium.app
BETTER_AUTH_URL=https://mathium.app
BETTER_AUTH_SECRET=          # openssl rand -hex 32
AUTH_REQUIRE_EMAIL_VERIFICATION=false
PLATFORM_OWNER_EMAILS=            # comma-separated; these accounts review the shared question library
APP_ENCRYPTION_SECRET=       # encrypts stored Google OAuth tokens

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@mathium.app

# Google Calendar OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://mathium.app/api/auth/google/callback

# Worker
WORKER_POLL_INTERVAL_MS=5000

# AI: limits live in the ai_limits table (/tutor/admin/ai). These people are switched on unless set Off there.
AI_ALLOWED_EMAILS=
AI_DAILY_LIMIT=300

# Contact shown on /privacy (set up forwarding at the registrar)
PRIVACY_CONTACT_EMAIL=privacy@mathium.app

# Plus plan for students on their own (Stripe). Billing stays off until all
# four are set. Webhook endpoint: https://mathium.app/api/billing/webhook
# with the events checkout.session.completed and customer.subscription.*
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTH=      # recurring price, CHF 9 a month (keep in step with lib/plans.ts)
STRIPE_PRICE_PLUS_YEAR=       # recurring price, CHF 69 a year
