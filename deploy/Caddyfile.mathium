# Mathium production site. Append to /etc/caddy/Caddyfile on m70q, then
# validate and reload (see deploy/README.md, "Going live").
mathium.app {
	encode zstd gzip
	# Access log to Caddy's journal (journalctl -u caddy); /var/log/caddy is
	# root-managed on m70q, so no new file there
	log {
		format json
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy 127.0.0.1:3110 {
		# Session rooms stream board updates (Server-Sent Events)
		flush_interval -1
	}
}

www.mathium.app {
	redir https://mathium.app{uri} permanent
}
